{
  "name": "tammha-backend",
  "version": "1.0.0",
  "description": "Tammha Graduation Project Management Backend - Production Foundation",
  "author": "Tammha Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "test:unit": "jest --testPathIgnorePatterns integration",
    "test:integration": "jest --testPathPattern integration",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:validate": "node scripts/prisma-validate.js",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "university:create": "ts-node scripts/create-university.ts",
    "verify": "npm run prisma:validate && npm run typecheck && npm run lint && npm test && npm run build",
    "storage:smoke": "ts-node -r tsconfig-paths/register scripts/storage-smoke.ts",
    "test:documents": "jest src/modules/documents",
    "livekit:smoke": "ts-node -r tsconfig-paths/register scripts/livekit-smoke.ts",
    "handbook": "ts-node -r tsconfig-paths/register scripts/handbook-admin.ts",
    "ai:smoke": "ts-node -r tsconfig-paths/register scripts/ai-smoke.ts",
    "render:predeploy": "node scripts/render/predeploy.js",
    "render:start": "node scripts/render/start.js",
    "admin:create": "ts-node -r tsconfig-paths/register scripts/create-admin.ts",
    "prod:verify": "ts-node -r tsconfig-paths/register scripts/deploy/verify-production.ts",
    "prod:cleanup": "ts-node -r tsconfig-paths/register scripts/deploy/cleanup-verification-data.ts",
    "prod:simulate": "ts-node -r tsconfig-paths/register scripts/deploy/simulate-production.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.10",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.10",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.2.10",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "^7.1.12",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "^5.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.6.1",
    "helmet": "8.1.0",
    "livekit-server-sdk": "2.18.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "1.1.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/testing": "^10.2.10",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^3.0.13",
    "@types/pdf-parse": "1.1.5",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "prisma": "^5.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.9.7",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "multer": "2.4.0"
  }
}
